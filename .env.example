# Tokens de integración Payku
# Obténlos en tu cuenta → Integración → Tokens integración y API
# Docs: https://docs.payku.com/

PAYKU_PUBLIC_TOKEN=
PAYKU_PRIVATE_TOKEN=

# Entorno: sandbox | production
# sandbox     → https://des.payku.cl/api
# production  → https://app.payku.cl/api
#
# Copia este archivo a `.env` (gitignored) y completa los tokens allí.
# `bun run test:integration` solo corre en sandbox con tokens reales en `.env`.
PAYKU_ENVIRONMENT=sandbox

# País del comercio (opcional, para Payku.fromEnvForCountry)
# CL | PE | VE
# PAYKU_COUNTRY=CL
