# Tokens de integración Payku
# Obténlos en tu cuenta → Integración → Tokens integración y API
# Docs: https://docs.payku.com/

PAYKU_PUBLIC_TOKEN=
PAYKU_PRIVATE_TOKEN=

# Entorno: sandbox | production
# sandbox     → https://des.payku.cl/api
# production  → https://app.payku.cl/api
PAYKU_ENVIRONMENT=sandbox

# Tests de integración (requieren credenciales reales)
# PAYKU_RUN_INTEGRATION_TESTS=false
